OPENAI_API_KEY=enter-ur-api-key
ANTHROPIC_API_KEY=enter-ur-api-key
GEMINI_API_KEY=enter-ur-api-key

# SupportIQ deployment/demo settings
DATA_DIR=data
EMBEDDING_MODEL=gemini-embedding-001
SUPPORTIQ_EMBEDDING_PROVIDER=auto
SUPPORTIQ_EMBEDDING_DIMENSIONS=768,1536,3072
DEFAULT_PROVIDER=template

# Retrieval backend
SUPPORTIQ_RETRIEVAL_MODE=adaptive
SUPPORTIQ_DENSE_CANDIDATE_K=20
SUPPORTIQ_SPARSE_CANDIDATE_K=20
SUPPORTIQ_COARSE_CANDIDATE_K=100
SUPPORTIQ_RRF_K=60
SUPPORTIQ_ADAPTIVE_RETRIEVAL=true
SUPPORTIQ_MULTI_QUERY_LIMIT=3
SUPPORTIQ_CONTEXT_MAX_SENTENCES=3code
SUPPORTIQ_FINAL_RERANKER=lexical
# SUPPORTIQ_FINAL_RERANKER=cross-encoder
SUPPORTIQ_CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
SUPPORTIQ_VECTOR_STORE=local
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=supportiq_chunks
# QDRANT_API_KEY=optional-for-managed-qdrant
SUPPORTIQ_FEEDBACK_PATH=data/feedback.jsonl
SUPPORTIQ_CHAT_HISTORY_PATH=data/chat_history.jsonl
