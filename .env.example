GEMINI_API_KEY=enter-ur-api-key

# GroundDesk deployment/demo settings
DATA_DIR=data
EMBEDDING_MODEL=gemini-embedding-2
GROUNDDESK_EMBEDDING_PROVIDER=auto
GROUNDDESK_EMBEDDING_DIMENSIONS=768,1536,3072
GROUNDDESK_GENERATION_MODEL=gemini-2.5-flash

# Retrieval backend
GROUNDDESK_RETRIEVAL_MODE=adaptive
GROUNDDESK_DENSE_CANDIDATE_K=20
GROUNDDESK_SPARSE_CANDIDATE_K=20
GROUNDDESK_COARSE_CANDIDATE_K=100
GROUNDDESK_RRF_K=60
GROUNDDESK_ADAPTIVE_RETRIEVAL=true
GROUNDDESK_MULTI_QUERY_LIMIT=3
GROUNDDESK_CONTEXT_MAX_SENTENCES=3
GROUNDDESK_FINAL_RERANKER=lexical
# GROUNDDESK_FINAL_RERANKER=cross-encoder
GROUNDDESK_CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
GROUNDDESK_VECTOR_STORE=local
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=grounddesk_chunks
# QDRANT_API_KEY=optional-for-managed-qdrant
GROUNDDESK_FEEDBACK_PATH=data/feedback.jsonl
GROUNDDESK_CHAT_HISTORY_PATH=data/chat_history.jsonl
