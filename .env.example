GEMINI_API_KEY=enter-ur-api-key

# GroundDesk deployment/demo settings
DATA_DIR=data
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_PROVIDER=auto
EMBEDDING_DIMENSIONS=768,1536,3072
GEMINI_EMBEDDING_MAX_ATTEMPTS=4
GEMINI_EMBEDDING_RETRY_BASE_SECONDS=2.0
GENERATION_MODEL=gemini-2.5-flash
# Used only when the primary generation model is quota-exhausted or unavailable.
GENERATION_FALLBACK_MODELS=gemini-2.5-flash-lite
# Retry transient Gemini generation overload/server errors; delay is useful for batch evaluations.
GEMINI_GENERATION_MAX_ATTEMPTS=4
GEMINI_GENERATION_RETRY_BASE_SECONDS=2.0
GEMINI_GENERATION_REQUEST_DELAY_SECONDS=0.0
# Maximum number of prior question/answer turns supplied to generation for a continued thread.
CONVERSATION_CONTEXT_TURNS=4
# Normal-user access mode:
#   demo     -> anonymous visitors are fixed to DEFAULT_WORKSPACE_ID only
#   supabase -> validates Bearer tokens and checks workspace membership in PostgreSQL
AUTH_MODE=demo
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Temporary management API guard. Leave unset to disable management endpoints.
ADMIN_API_KEY=
DEFAULT_WORKSPACE_ID=demo

# Retrieval backend
RETRIEVAL_MODE=hybrid
DENSE_CANDIDATE_K=20
SPARSE_CANDIDATE_K=20
COARSE_CANDIDATE_K=100
RRF_K=60
ADAPTIVE_RETRIEVAL=false
MULTI_QUERY_LIMIT=3
# Optional production-style structured query planner. Set RETRIEVAL_MODE=planned
# and QUERY_PLANNER_PROVIDER=gemini only after evaluating its recall and API cost.
QUERY_PLANNER_PROVIDER=off
QUERY_PLANNER_MODEL=gemini-2.5-flash
CONTEXT_MAX_SENTENCES=3
FINAL_RERANKER=lexical
# FINAL_RERANKER=cross-encoder
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
VECTOR_STORE=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=grounddesk_chunks
# QDRANT_API_KEY=optional-for-managed-qdrant
FEEDBACK_PATH=data/feedback.jsonl
CHAT_HISTORY_PATH=data/chat_history.jsonl

# Product-state persistence. Leave jsonl for a zero-setup local/demo run.
# For Supabase/PostgreSQL: apply migrations/0001_product_interactions.sql,
# then set PERSISTENCE_BACKEND=database and DATABASE_URL to the server-side URL.
PERSISTENCE_BACKEND=jsonl
# postgresql:// and postgresql+psycopg2:// Supabase URLs are normalized to psycopg v3.
DATABASE_URL=
DATABASE_AUTO_CREATE=false

# Product-specific labelled evaluation dataset used by the support evaluation runner/endpoint.
SUPPORT_EVAL_DATASET_PATH=benchmarks/datasets/grounddesk_support_v1.json
